    # === Hotplug: Đảm bảo AGH port 53 sau mỗi lần reboot/mất điện ===
    cat > /etc/hotplug.d/iface/99-adguardhome << 'AGHEOF'
#!/bin/sh
[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wan" ] || [ "$INTERFACE" = "lan" ] || exit 0

# Chỉ chạy 1 lần (tránh chạy lại khi cả lan và wan ifup cùng lúc)
LOCKFILE="/tmp/agh-hotplug.lock"
[ -f "$LOCKFILE" ] && exit 0
touch "$LOCKFILE"

sleep 2

# Bước 1: Đảm bảo dnsmasq không chiếm port 53
DNSMASQ_PORT=$(uci -q get dhcp.@dnsmasq[0].port)
if [ "$DNSMASQ_PORT" != "0" ]; then
    uci set dhcp.@dnsmasq[0].port='0'
    uci commit dhcp
    /etc/init.d/dnsmasq restart
    sleep 1
fi

# Bước 2: Khởi động hoặc kiểm tra AGH
if [ -f /etc/init.d/adguardhome ]; then
    /etc/init.d/adguardhome status >/dev/null 2>&1 || /etc/init.d/adguardhome start
    sleep 3

    # Bước 3: Kiểm tra AGH đã bind port 53 chưa
    if netstat -tlnp 2>/dev/null | grep ":53 " | grep -qi "adguard"; then
        logger -t "agh-hotplug" "OK: AdGuard Home on port 53 after $INTERFACE ifup"
    else
        # Thử restart lần nữa
        /etc/init.d/adguardhome restart
        sleep 4
        if netstat -tlnp 2>/dev/null | grep ":53 " | grep -qi "adguard"; then
            logger -t "agh-hotplug" "OK: AdGuard Home on port 53 after restart"
        else
            # AGH thất bại → khôi phục dnsmasq làm DNS để mạng không bao giờ bị mất
            logger -t "agh-hotplug" "FALLBACK: AGH failed, restoring dnsmasq DNS"
            uci set dhcp.@dnsmasq[0].port='53'
            uci set dhcp.@dnsmasq[0].noresolv='0'
            uci del_list dhcp.@dnsmasq[0].server='1.1.1.1' 2>/dev/null
            uci add_list dhcp.@dnsmasq[0].server='1.1.1.1'
            uci add_list dhcp.@dnsmasq[0].server='8.8.8.8'
            uci commit dhcp
            /etc/init.d/dnsmasq restart
        fi
    fi
fi

# Xoá lock sau 30s
(sleep 30 && rm -f "$LOCKFILE") &
AGHEOF
    chmod +x /etc/hotplug.d/iface/99-adguardhome

    # Khởi động AdGuard Home ngay lập tức
    /etc/init.d/adguardhome start 2>/dev/null || true

    logger -t "newifi-d2-setup" "AdGuard Home configured on port 53 (direct mode)"
fi

exit 0

